#!/usr/bin/env python3
"""
LOCALIZE — Simple CLI for Personal AI Sovereignty

Usage:
  localize "thing you want to localize"
  
Examples:
  localize "I need to shift priorities towards job hunting"
  localize "my preferred apps for these tasks"
  localize "the research we've done here"

The system asks follow-up questions to categorize and store appropriately.
"""

import json
import argparse
import sys
from pathlib import Path
from datetime import datetime
from typing import Optional

# Add src to path for background enrichment
sys.path.insert(0, '/home/kinch/Projects/localize_it/src')

PROJECT_DIR = Path.home() / "Projects" / "localize_it"
DATA_DIR = PROJECT_DIR / "data"
LOG_FILE = DATA_DIR / "localize" / "entries.jsonl"

# Background enricher (lazy-loaded)
_enricher = None

def get_enricher():
    """Lazy-load the enricher only when needed."""
    global _enricher
    if _enricher is None:
        from pipeline.automatic_enrichment import AutomaticEnricher
        _enricher = AutomaticEnricher()
    return _enricher


def ensure_dirs():
    """Ensure data directories exist."""
    (DATA_DIR / "localize").mkdir(parents=True, exist_ok=True)
    (DATA_DIR / "intraday").mkdir(parents=True, exist_ok=True)
    (DATA_DIR / "explicit" / "contexts").mkdir(parents=True, exist_ok=True)
    (DATA_DIR / "explicit" / "frameworks").mkdir(parents=True, exist_ok=True)
    (DATA_DIR / "explicit" / "styles").mkdir(parents=True, exist_ok=True)
    (DATA_DIR / "explicit" / "voices").mkdir(parents=True, exist_ok=True)


def ask_multiple_choice(question: str, options: list, allow_custom: bool = True) -> str:
    """Ask user to select from options."""
    print(f"\n{question}")
    for i, option in enumerate(options, 1):
        print(f"  [{i}] {option}")
    if allow_custom:
        print(f"  [c] Custom (type your own)")
    print(f"  [s] Skip")
    
    while True:
        choice = input("\nSelect: ").strip().lower()
        
        if choice == 's':
            return "skip"
        
        if choice == 'c' and allow_custom:
            custom = input("Your answer: ").strip()
            return custom if custom else "skip"
        
        try:
            idx = int(choice) - 1
            if 0 <= idx < len(options):
                return options[idx]
        except ValueError:
            pass
        
        print("Invalid choice. Try again.")


def capture_structured_entry(raw_input: str, category: str, structured_data: dict):
    """Capture entry with structured data and automatic enrichment."""
    
    entry = {
        "timestamp": datetime.now().isoformat(),
        "raw_input": raw_input,
        "category": category,
        "processed": False
    }
    
    # Merge structured data
    entry.update(structured_data)
    
    # BACKGROUND ENRICHMENT
    try:
        enricher = get_enricher()
        entry = enricher.enrich_capture(entry)
    except Exception:
        pass
    
    # Save to localize log
    ensure_dirs()
    with open(LOG_FILE, 'a') as f:
        f.write(json.dumps(entry) + '\n')
    
    # Route to appropriate tier storage
    if category == "preference":
        _save_to_intraday("preferences", entry)
    elif category == "pattern":
        _save_to_intraday("patterns", entry)
    elif category == "framework":
        _save_to_explicit("frameworks", entry)
    elif category == "context":
        _save_to_explicit("contexts", entry)
    elif category == "discovery":
        _save_to_explicit("discoveries", entry)
    elif category == "voice":
        _save_to_explicit("voices", entry)
    elif category == "style":
        _save_to_explicit("styles", entry)
    
    return entry


def capture_entry(raw_input: str, category: str, subcategory: Optional[str] = None, tags: list = None):
    """Capture the localized entry with automatic background enrichment."""
    
    entry = {
        "timestamp": datetime.now().isoformat(),
        "raw_input": raw_input,
        "category": category,
        "subcategory": subcategory,
        "tags": tags or [],
        "processed": False
    }
    
    # BACKGROUND ENRICHMENT (no user action required)
    try:
        enricher = get_enricher()
        entry = enricher.enrich_capture(entry)
    except Exception as e:
        # Fail silently - enrichment is optional
        pass
    
    # Save to localize log
    ensure_dirs()
    with open(LOG_FILE, 'a') as f:
        f.write(json.dumps(entry) + '\n')
    
    # Also route to appropriate tier storage
    if category == "preference":
        _save_to_intraday("preferences", entry)
    elif category == "pattern":
        _save_to_intraday("patterns", entry)
    elif category == "framework":
        _save_to_explicit("frameworks", entry)
    elif category == "context":
        _save_to_explicit("contexts", entry)
    elif category == "discovery":
        _save_to_explicit("discoveries", entry)
    
    return entry


def _save_to_intraday(type_name: str, entry: dict):
    """Save to intraday storage."""
    filepath = DATA_DIR / "intraday" / f"{type_name}.jsonl"
    with open(filepath, 'a') as f:
        f.write(json.dumps(entry) + '\n')


def _save_to_explicit(type_name: str, entry: dict):
    """Save to explicit storage."""
    filepath = DATA_DIR / "explicit" / type_name / f"{type_name}.jsonl"
    filepath.parent.mkdir(parents=True, exist_ok=True)
    with open(filepath, 'a') as f:
        f.write(json.dumps(entry) + '\n')


def interactive_categorize(raw_input: str) -> dict:
    """Interactive categorization with follow-up questions."""
    
    print(f"\n{'='*60}")
    print(f"LOCALIZE: \"{raw_input[:60]}{'...' if len(raw_input) > 60 else ''}\"")
    print(f"{'='*60}")
    
    # Question 1: What is this?
    category = ask_multiple_choice(
        "What would you call this?",
        [
            "A preference / working style (how I like things)",
            "A pattern (something I do repeatedly)",
            "A framework / decision process (how I approach things)",
            "A context (project/situation specific)",
            "A voice / persona (how I sound)",
            "A discovery (something I just realized)",
            "Research (information I gathered)",
            "Just a note (capture for later)"
        ]
    )
    
    if category == "skip":
        print("Skipped.")
        return None
    
    # Map to internal category
    category_map = {
        "A preference / working style (how I like things)": "style",
        "A pattern (something I do repeatedly)": "pattern",
        "A framework / decision process (how I approach things)": "framework",
        "A context (project/situation specific)": "context",
        "A voice / persona (how I sound)": "voice",
        "A discovery (something I just realized)": "discovery",
        "Research (information I gathered)": "research",
        "Just a note (capture for later)": "note"
    }
    internal_cat = category_map.get(category, "note")
    
    # STRUCTURED DATA COLLECTION based on category
    structured_data = {}
    
    if internal_cat == "framework":
        print("\n📋 FRAMEWORK CAPTURE")
        print("-" * 40)
        
        # Framework name
        name = input("Framework name (short, like 'Priority Matrix' or 'Triage Method'): ").strip()
        if not name:
            name = raw_input[:40] if len(raw_input) <= 40 else raw_input[:37] + "..."
        structured_data["name"] = name
        
        # Description
        description = input("Brief description: ").strip()
        if not description:
            description = raw_input
        structured_data["description"] = description
        
        # Steps
        print("\nSteps (enter one per line, blank line when done):")
        steps = []
        step_num = 1
        while True:
            step = input(f"  Step {step_num}: ").strip()
            if not step:
                break
            steps.append(step)
            step_num += 1
        if steps:
            structured_data["steps"] = steps
        
        # Triggers
        triggers_input = input("\nWhen do you use this? (comma-separated, or Enter to skip): ").strip()
        if triggers_input:
            structured_data["triggers"] = [t.strip() for t in triggers_input.split(",") if t.strip()]
        
        # Capture structured
        entry = capture_structured_entry(raw_input, internal_cat, structured_data)
        
        print(f"\n✓ Framework captured: {name}")
        print(f"  Steps: {len(steps)}")
        
    elif internal_cat == "style":
        print("\n🎨 STYLE CAPTURE")
        print("-" * 40)
        
        # Style name
        name = input("Style name (e.g., 'My Brief Mode' or 'Collaborative Voice'): ").strip()
        if not name:
            name = "Working Style"
        structured_data["name"] = name
        
        # Description
        description = input("Description of this style: ").strip()
        if not description:
            description = raw_input
        structured_data["description"] = description
        
        # Examples
        print("\nExample phrases (how you sound when using this style):")
        examples = []
        for i in range(1, 4):
            ex = input(f"  Example {i}: ").strip()
            if ex:
                examples.append(ex)
            else:
                break
        if examples:
            structured_data["examples"] = examples
        
        # Capture structured
        entry = capture_structured_entry(raw_input, internal_cat, structured_data)
        
        print(f"\n✓ Style captured: {name}")
        print(f"  Examples: {len(examples)}")
        
    elif internal_cat == "context":
        print("\n📁 CONTEXT CAPTURE")
        print("-" * 40)
        
        # Project name
        project = input("Project name: ").strip()
        if not project:
            project = "Unnamed Project"
        structured_data["project"] = project
        
        # Stack
        stack = input("Tech stack / tools (comma-separated): ").strip()
        if stack:
            structured_data["stack"] = stack
        
        # Patterns
        patterns_input = input("Common patterns on this project (comma-separated, or Enter to skip): ").strip()
        if patterns_input:
            structured_data["patterns"] = [p.strip() for p in patterns_input.split(",") if p.strip()]
        
        # Conventions
        conventions_input = input("Project conventions (comma-separated, or Enter to skip): ").strip()
        if conventions_input:
            structured_data["conventions"] = [c.strip() for c in conventions_input.split(",") if c.strip()]
        
        # Capture structured
        entry = capture_structured_entry(raw_input, internal_cat, structured_data)
        
        print(f"\n✓ Context captured: {project}")
        
    elif internal_cat == "voice":
        print("\n🎭 VOICE/PERSONA CAPTURE")
        print("-" * 40)
        
        # Voice name
        name = input("Voice/persona name (e.g., 'Shepherd', 'Formal Mode', 'Casular Kinch'): ").strip()
        if not name:
            name = "Personal Voice"
        structured_data["name"] = name
        
        # Traits
        traits_input = input("Traits (comma-separated, e.g., 'direct, technical, patient'): ").strip()
        if traits_input:
            structured_data["traits"] = [t.strip() for t in traits_input.split(",") if t.strip()]
        
        # Markers
        markers_input = input("Linguistic markers (phrases you use, comma-separated): ").strip()
        if markers_input:
            structured_data["markers"] = [m.strip() for m in markers_input.split(",") if m.strip()]
        
        # Examples
        print("\nExample phrases:")
        examples = []
        for i in range(1, 4):
            ex = input(f"  Example {i}: ").strip()
            if ex:
                examples.append(ex)
            else:
                break
        if examples:
            structured_data["examples"] = examples
        
        # Capture structured
        entry = capture_structured_entry(raw_input, internal_cat, structured_data)
        
        print(f"\n✓ Voice captured: {name}")
        
    else:
        # Standard capture for other categories
        # Question 2: Subcategory (context-dependent)
        subcategory = None
        tags = []
        
        if internal_cat == "pattern":
            subcategory = ask_multiple_choice(
                "What kind of pattern?",
                [
                    "Query pattern (how I ask for things)",
                    "Work pattern (how I approach tasks)",
                    "Decision pattern (how I choose)",
                    "Communication pattern (how I interact)"
                ]
            )
            if subcategory == "skip":
                subcategory = None
        
        elif internal_cat == "discovery":
            subcategory = ask_multiple_choice(
                "What kind of discovery?",
                [
                    "Priority shift (changing focus)",
                    "Insight (new understanding)",
                    "Decision (made a choice)",
                    "Problem identified",
                    "Solution found"
                ]
            )
            if subcategory == "skip":
                subcategory = None
        
        # Question 3: Tags
        print("\nAdd tags (comma-separated, or press Enter to skip):")
        tags_input = input("Tags: ").strip()
        if tags_input:
            tags.extend([t.strip() for t in tags_input.split(",") if t.strip()])
        
        # Capture it
        entry = capture_entry(raw_input, internal_cat, subcategory, tags)
        
        # Confirmation
        print(f"\n✓ Localized as: {internal_cat}")
        if subcategory:
            print(f"  Subcategory: {subcategory}")
        if tags:
            print(f"  Tags: {', '.join(tags)}")
    
    print(f"  Saved to: {LOG_FILE}")
    
    # Suggest next step for discoveries
    if internal_cat == "discovery" and "Priority shift" in (subcategory or ""):
        print(f"\n💡 This looks like a priority shift.")
        follow = ask_multiple_choice(
            "Want to create an action item?",
            ["Yes, create TODO", "No, just capture"],
            allow_custom=False
        )
        if "Yes" in follow:
            print("  [Would create TODO in your task system]")
    
    return entry


def quick_capture(raw_input: str, category: str, structured: bool = False):
    """Quick capture without interactive questions."""
    
    if structured and category in ["framework", "style", "context", "voice"]:
        # For structured categories, we need the interactive prompts
        # Fall back to interactive mode
        return interactive_categorize(raw_input)
    
    entry = capture_entry(raw_input, category)
    print(f"✓ Quick-captured as {category}")
    return entry


def list_recent(n: int = 10):
    """List recent localized entries."""
    if not LOG_FILE.exists():
        print("No entries yet.")
        return
    
    entries = []
    with open(LOG_FILE, 'r') as f:
        for line in f:
            if line.strip():
                try:
                    entries.append(json.loads(line))
                except:
                    continue
    
    print(f"\nRecent Localizations (last {min(n, len(entries))}):")
    print("=" * 60)
    
    for entry in entries[-n:]:
        ts = entry.get("timestamp", "")[:10]
        cat = entry.get("category", "unknown")
        text = entry.get("raw_input", "")[:50]
        print(f"\n[{ts}] {cat}: \"{text}...\"")


def search_with_context(query: str, prefer_present: bool = True):
    """Search captures using temporal + Hebbian enrichment."""
    from pipeline.enhanced_retrieval import EnhancedRetriever
    
    retriever = EnhancedRetriever()
    results = retriever.search(query, prefer_present=prefer_present)
    
    if not results:
        print("No results found.")
        return
    
    print(f"\nResults for: \"{query}\"")
    print("=" * 60)
    
    for i, result in enumerate(results[:10], 1):
        cap = result['capture']
        score = result['score']
        temporal = result.get('temporal_state', 'unknown')
        hebbian = '✓' if result.get('hebbian_boost') else ' '
        temporal_mark = '●' if temporal == 'present' else '○'
        
        content = cap.get('content', cap.get('raw_input', ''))[:70]
        cat = cap.get('category', 'unknown')
        
        print(f"\n{i}. [{cat}] {content}...")
        print(f"   Score: {score:.2f} {temporal_mark} {temporal} [Hebbian: {hebbian}]")


def what_am_i_building():
    """Show present-temporal captures — auto-filtered active work."""
    from pipeline.enhanced_retrieval import EnhancedRetriever
    
    retriever = EnhancedRetriever()
    present = retriever.get_present_work()
    
    if not present:
        print("No active work detected. Try 'localize --search building'.")
        return
    
    print("\n🔨 What you're actively building (temporal=present):")
    print("=" * 60)
    
    for i, cap in enumerate(present[:10], 1):
        content = cap.get('content', cap.get('raw_input', ''))[:70]
        conf = cap.get('temporal', {}).get('confidence', 0)
        cat = cap.get('category', 'unknown')
        ts = cap.get('timestamp', '')[:10]
        
        print(f"\n{i}. [{cat}] {ts}")
        print(f"   {content}...")
        print(f"   Confidence: {conf:.0%}")


def main():
    parser = argparse.ArgumentParser(
        description="LOCALIZE — Capture anything for your personal AI",
        usage="localize [THING_TO_LOCALIZE] [options]"
    )
    parser.add_argument(
        "thing",
        nargs="?",
        help="What you want to localize (quote it if it has spaces)"
    )
    parser.add_argument(
        "--type", "-t",
        choices=["preference", "pattern", "framework", "context", "discovery", "research", "note", "style", "voice"],
        help="Skip questions and capture directly as this type"
    )
    parser.add_argument(
        "--list", "-l",
        action="store_true",
        help="List recent captures"
    )
    parser.add_argument(
        "--status",
        action="store_true",
        help="Show system status"
    )
    parser.add_argument(
        "--search", "-s",
        metavar="QUERY",
        help="Search captures (temporal + Hebbian enhanced)"
    )
    parser.add_argument(
        "--building", "-b",
        action="store_true",
        help="What am I actively building? (temporal=present)"
    )
    
    args = parser.parse_args()
    
    if args.status:
        print("LOCALIZE Status")
        print("=" * 60)
        print(f"Data directory: {DATA_DIR}")
        print(f"Log file: {LOG_FILE}")
        
        if LOG_FILE.exists():
            count = sum(1 for _ in open(LOG_FILE))
            print(f"Total entries: {count}")
            
            # Show enrichment stats
            try:
                from pipeline.enhanced_retrieval import EnhancedRetriever
                retriever = EnhancedRetriever()
                present = retriever.get_present_work()
                print(f"Active work items: {len(present)}")
            except:
                pass
        else:
            print("Total entries: 0")
        return
    
    if args.search:
        search_with_context(args.search)
        return
    
    if args.building:
        what_am_i_building()
        return
    
    if args.list:
        list_recent()
        return
    
    if not args.thing:
        # Interactive mode
        print("LOCALIZE — Personal AI Sovereignty")
        print("=" * 60)
        print("\nWhat do you want to localize?")
        print("(Type your entry, or 'quit' to exit)\n")
        
        while True:
            user_input = input("> ").strip()
            
            if user_input.lower() in ['quit', 'exit', 'q']:
                print("Goodbye!")
                break
            
            if not user_input:
                continue
            
            interactive_categorize(user_input)
            print("\n" + "-" * 40)
        
        return
    
    # Single capture mode
    if args.type:
        # For structured types, force interactive mode
        if args.type in ["framework", "style", "context", "voice"]:
            interactive_categorize(args.thing)
        else:
            quick_capture(args.thing, args.type, structured=False)
    else:
        interactive_categorize(args.thing)


if __name__ == "__main__":
    main()
